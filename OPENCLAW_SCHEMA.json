{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VÉLØ Oracle Betting Card Schema",
  "description": "Schema for betting cards exported by OpenClaw for ingestion by VÉLØ Oracle Prime.",
  "type": "object",
  "properties": {
    "meeting": {
      "type": "string",
      "description": "Name of the race meeting (e.g., 'Punchestown', 'Ascot')."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the meeting in YYYY-MM-DD format."
    },
    "going": {
      "type": "string",
      "description": "Track condition (e.g., 'Heavy', 'Good to Soft')."
    },
    "races": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Race time in HH:MM format (24-hour)."
          },
          "race_number": {
            "type": "integer",
            "description": "Ordinal number of the race."
          },
          "name": {
            "type": "string",
            "description": "Name or title of the race."
          },
          "selections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "horse": {
                  "type": "string",
                  "description": "Name of the horse."
                },
                "bet_type": {
                  "type": "string",
                  "enum": ["WIN", "EW", "PLACE", "LAY"],
                  "description": "Type of bet recommended."
                },
                "stake_percentage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Recommended stake as a percentage of bankroll."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Confidence level in the selection (0-100)."
                },
                "edge": {
                  "type": "string",
                  "description": "Description of the edge (e.g., '+13lb', 'Speed Rating')."
                },
                "analysis": {
                  "type": "string",
                  "description": "Brief reasoning for the selection."
                },
                "metrics": {
                  "type": "object",
                  "properties": {
                    "OR": { "type": "integer" },
                    "TS": { "type": "integer" },
                    "RPR": { "type": "integer" },
                    "Postdata": { "type": "string" }
                  }
                }
              },
              "required": ["horse", "bet_type", "confidence"]
            }
          }
        },
        "required": ["time", "race_number", "selections"]
      }
    }
  },
  "required": ["meeting", "date", "races"]
}
