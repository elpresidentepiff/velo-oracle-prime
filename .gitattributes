# Force Unix LF line endings for all shell scripts and files that run in containers
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf
requirements*.txt text eol=lf
Procfile text eol=lf
