-def classify_consistency_band(consistency: float) -> str:
-    """
-    Classify consistency into bands.
-    
-    Args:
-        consistency: Consistency score (0.0-1.0)
-        
-    Returns:
-        Band: HIGH, MEDIUM, LOW
