+def _stringify_upsert_error(exc: Exception) -> str:
+    parts = [str(exc)]
+    for attr in ("message", "details", "hint"):
+        value = getattr(exc, attr, None)
+        if value:
+            parts.append(str(value))
+    return " | ".join(part for part in parts if part)
+
+
+def _is_schema_error(error_text: str) -> bool:
+    lowered = error_text.lower()
+    return any(token in lowered for token in ("column", "schema cache", "does not exist", "could not find"))
+
+
+def _match_optional_group_from_error(
+    exc: Exception,
+    optional_groups: list[tuple[str, list[str], str]],
+    removed_groups: set[str],
+) -> tuple[str, list[str], str] | None:
+    error_text = _stringify_upsert_error(exc)
+    if not _is_schema_error(error_text):
+        return None
+
+    matches = []
+    for group_name, group_cols, group_hint in optional_groups:
+        if group_name in removed_groups:
+            continue
+        if any(re.search(rf"\b{re.escape(col)}\b", error_text, re.IGNORECASE) for col in group_cols):
+            matches.append((group_name, group_cols, group_hint))
+
+    if len(matches) == 1:
+        return matches[0]
+    return None
+
