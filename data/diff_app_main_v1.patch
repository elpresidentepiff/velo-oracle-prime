+@app.get("/api/dashboard-daily")
+async def dashboard_daily(date: str = Query(default=None)):
+    """
+    Serve daily predictions for dashboard panel C.
+    Reads data/dashboard_daily_predictions_YYYYMMDD.json (written by publisher script).
+    Falls back to most recent available file if exact date not found.
+    """
+    from datetime import UTC, datetime as _dt
+
+    target_date = date or _dt.now(UTC).strftime("%Y-%m-%d")
+    date_tag = target_date.replace("-", "_")
+    root = pathlib.Path(__file__).parent.parent
+    path = root / "data" / f"dashboard_daily_predictions_{date_tag}.json"
+
+    if not path.exists():
+        # Find most recent available file
+        candidates = sorted(root.glob("data/dashboard_daily_predictions_*.json"), reverse=True)
+        if not candidates:
+            raise HTTPException(
+                status_code=404,
+                detail={
+                    "error": "no_predictions_found",
+                    "requested_date": target_date,
+                    "hint": f"Run: python scripts/publish_daily_predictions_to_dashboard.py --date {target_date}",
+                },
+            )
+        path = candidates[0]
+
+    try:
+        payload = json.loads(path.read_text())
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Failed to read predictions file: {e}")
+
+    # Group flat predictions list into races
+    predictions = payload.get("predictions", [])
+    race_map: dict = {}
+    for p in predictions:
+        rid = p.get("race_id", "")
+        if rid not in race_map:
+            race_map[rid] = {
+                "race_id":      rid,
+                "race_time":    p.get("race_time", ""),
+                "course":       p.get("course", ""),
+                "race_name":    p.get("race_name", ""),
+                "decision_tier": p.get("decision_tier", "?"),
+                "runners":      [],
+            }
+        race_map[rid]["runners"].append(p)
+
+    race_list = sorted(race_map.values(), key=lambda r: r.get("race_time") or "")
+
+    return {
+        "meta": {
+            "publish_date":     payload.get("publish_date", target_date),
+            "requested_date":   target_date,
+            "loaded_file":      path.name,
+            "races":            len(race_list),
+            "runners":          len(predictions),
+            "source":           payload.get("source", ""),
+            "publisher_version": payload.get("publisher_version", ""),
+            "generated_at":     payload.get("generated_at", ""),
+        },
+        "races": race_list,
+    }
+
+
 # Root endpoint
 @app.get("/")
 async def root():
