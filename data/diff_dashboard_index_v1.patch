+
+// ── Panel C: Daily Predictions All Runners ───────────────────────
+let _arpLoaded = false;
+
+function toggleARP() {
+  const body = document.getElementById('arp-body');
+  const icon = document.getElementById('arp-toggle-icon');
+  const open = body.classList.toggle('open');
+  icon.textContent = open ? '▲' : '▼';
+  document.getElementById('arp-header').style.borderBottomColor = open ? 'rgba(0,200,255,0.15)' : 'transparent';
+  if (open && !_arpLoaded) _loadARP();
+}
+
+function _arpVpClass(vp) {
+  if (vp === null || vp === undefined) return '';
+  if (vp >= 0.40) return 'arp-vp-hi';
+  if (vp >= 0.30) return 'arp-vp-mid';
+  return 'arp-vp-lo';
+}
+
+function _arpBadges(r) {
+  const parts = [];
+  if (r.vp30_tier_a)            parts.push('<span class="arp-flag arp-f-vpta">VP30·A</span>');
+  if (r.mds_high)               parts.push('<span class="arp-flag arp-f-mds">MDS HIGH</span>');
+  if (r.tier_a && !r.vp30_tier_a) parts.push('<span class="arp-flag arp-f-ta">TIER A</span>');
+  if (r.vp30 && !r.vp30_tier_a) parts.push('<span class="arp-flag arp-f-vp30">VP30</span>');
+  if (r.improve_high)           parts.push('<span class="arp-flag arp-f-imp">IMP HIGH</span>');
+  if (r.b_tier_low_vp_suppress) parts.push('<span class="arp-flag arp-f-blvp">B·LOW·VP</span>');
+  return parts.join('');
+}
+
+function _arpFmt(v, decimals=3) {
+  if (v === null || v === undefined) return '<span style="color:var(--text-dim)">—</span>';
+  return (parseFloat(v)*100).toFixed(decimals === 0 ? 0 : 1) + '%';
+}
+
+function _buildARPRaceBlock(race) {
+  const tierCls = 'arp-tier-' + (race.decision_tier || 'q');
+  const rows = race.runners.map((r, i) => {
+    const vpCls = _arpVpClass(r.velo_prime_prob);
+    const mdsHi = r.mds_high ? 'arp-mds-hi' : '';
+    const sid = JSON.stringify(r.sidecars || {}, null, 2);
+    const rowId = `arp-sd-${race.race_id}-${i}`;
+    return `
+      <tr>
+        <td class="arp-rank">${r.rank}</td>
+        <td class="arp-name">${r.horse_name || '—'}</td>
+        <td class="${vpCls}">${r.velo_prime_prob != null ? (r.velo_prime_prob*100).toFixed(1)+'%' : '—'}</td>
+        <td class="${mdsHi}">${r.market_deception_score != null ? r.market_deception_score.toFixed(3) : '—'}</td>
+        <td>${r.improvement_score != null ? r.improvement_score.toFixed(3) : '—'}</td>
+        <td>${r.place_prob != null ? (r.place_prob*100).toFixed(1)+'%' : '—'}</td>
+        <td><span class="arp-tier-badge ${tierCls}">${r.decision_tier || '?'}</span></td>
+        <td><div class="arp-flags">${_arpBadges(r)}</div></td>
+        <td><button class="arp-sidecar-btn" onclick="document.getElementById('${rowId}').classList.toggle('open')">JSON</button></td>
+      </tr>
+      <tr class="arp-sidecar-row"><td colspan="9"><pre id="${rowId}" class="arp-sidecar-json">${sid}</pre></td></tr>`;
+  }).join('');
+
+  return `<div class="arp-race">
+    <div class="arp-race-hdr">
+      <span class="arp-course">${race.course || race.race_id}</span>
+      <span class="arp-time">${race.race_time || ''}</span>
+      <span class="arp-tier-badge ${tierCls}">${race.decision_tier || '?'}</span>
+      <span style="font-size:.65rem;color:var(--text-dim)">${race.race_name || ''}</span>
+    </div>
+    <table class="arp-runners">
+      <thead><tr>
+        <th>#</th><th>HORSE</th><th>VP%</th><th>MDS</th><th>IMP</th><th>PLACE%</th><th>TIER</th><th>FLAGS</th><th></th>
+      </tr></thead>
+      <tbody>${rows}</tbody>
+    </table>
+  </div>`;
+}
+
+async function _loadARP() {
+  const today = new Date().toISOString().slice(0,10);
+  const summaryEl = document.getElementById('arp-summary-bar');
+  const racesEl   = document.getElementById('arp-races');
+  const metaEl    = document.getElementById('arp-header-meta');
+  summaryEl.textContent = 'Loading…';
+  try {
+    const res = await fetch(`/api/dashboard-daily?date=${today}`);
+    if (!res.ok) { summaryEl.textContent = `No predictions found for ${today}`; return; }
+    const data = await res.json();
+    _arpLoaded = true;
+    const meta = data.meta || {};
+    const races = data.races || [];
+    const totalRunners = races.reduce((s,r)=>s+(r.runners||[]).length, 0);
+    const tierA   = races.reduce((s,r)=>s+(r.runners||[]).filter(x=>x.tier_a).length, 0);
+    const vp30    = races.reduce((s,r)=>s+(r.runners||[]).filter(x=>x.vp30).length, 0);
+    const vpta    = races.reduce((s,r)=>s+(r.runners||[]).filter(x=>x.vp30_tier_a).length, 0);
+    const mdsHi   = races.reduce((s,r)=>s+(r.runners||[]).filter(x=>x.mds_high).length, 0);
+    metaEl.innerHTML = `${races.length} races · ${totalRunners} runners · <span style="color:var(--cyan)">${meta.source||''}</span>`;
+    summaryEl.innerHTML =
+      `<span>RACES <b>${races.length}</b></span>` +
+      `<span>RUNNERS <b>${totalRunners}</b></span>` +
+      `<span style="color:#00ffa0">TIER A <b>${tierA}</b></span>` +
+      `<span>VP30 <b>${vp30}</b></span>` +
+      `<span style="color:#00ffa0">VP30·A <b>${vpta}</b></span>` +
+      `<span style="color:#ff9800">MDS HIGH <b>${mdsHi}</b></span>` +
+      `<span style="color:var(--text-dim);margin-left:8px">${meta.publish_date||today}</span>`;
+    racesEl.innerHTML = races.sort((a,b)=>(a.race_time||'').localeCompare(b.race_time||'')).map(_buildARPRaceBlock).join('');
+  } catch(e) {
+    summaryEl.textContent = 'Error loading predictions: ' + e.message;
+  }
+}
 </script>
